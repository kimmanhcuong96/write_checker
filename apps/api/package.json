{
  "name": "@me2write/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "prebuild": "wrangler types",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env production --keep-vars",
    "db:migrate": "node scripts/migrate.mjs",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@neondatabase/serverless": "^1.0.1",
    "hono": "^4.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  }
}
