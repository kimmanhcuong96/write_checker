# API secrets (copy to apps/api/.dev.vars for local development)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-characters
AI_ACCOUNT_ID=
AI_API_TOKEN=

# API non-secret runtime configuration (also mirrored in wrangler.jsonc vars)
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
ENVIRONMENT=development
LLM_PROVIDER=cloudflare
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
MAX_WRITING_WORDS=1000
MAX_EVALUATIONS_PER_DAY=30
# Optional. When absent, no application token ceiling is invented.
# LLM_MAX_TOKENS=1000000
# Comma-separated Google emails authorized for admin endpoints.
ADMIN_EMAILS=

# Frontend (copy to apps/web/.env.local)
VITE_API_ORIGIN=http://localhost:8787
